{
  "name": "developer-portal",
  "version": "0.1.0",
  "private": true,
  "description": "The PaymentFlow merchant developer portal (M23).",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "verify:interactions": "node scripts/verify-interactions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "stub:platform": "node scripts/stub-platform.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:api-keys": "node scripts/verify-api-keys.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.7",
    "eslint-config-prettier": "^10.0.1",
    "playwright-core": "^1.56.1",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
